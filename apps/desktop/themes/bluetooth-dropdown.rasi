configuration {
    font:                           "JetBrainsMono Nerd Font 11";
    show-icons:                     true;
    icon-theme:                     "Papirus";
    disable-history:                false;
    click-to-exit:                  true;
    hide-scrollbar:                 true;
}

* {
    bg0:          #282828;
    bg1:          #32302f;
    bg2:          #3c3836;
    bg3:          #504945;
    grey0:        #7c6f64;
    fg0:          #d4be98;
    red:          #ea6962;
    green:        #a9b665;
    yellow:       #d8a657;
    blue:         #7daea3;
    aqua:         #89b482;
    orange:       #e78a4e;

    background-color:               @bg0;
    text-color:                     @fg0;
}

window {
    transparency:                   "real";
    background-color:               @bg0;
    text-color:                     @fg0;
    border:                         1px;
    border-color:                   @bg3;
    border-radius:                  12px;
    width:                          340px;
    location:                       north east;
    anchor:                         north east;
    x-offset:                       -10;
    y-offset:                       40;
}

message {
    padding:                        10px 16px 6px 16px;
    background-color:               @bg1;
    border:                         0px 0px 1px 0px;
    border-color:                   @bg3;
    border-radius:                  12px 12px 0px 0px;
}

textbox {
    text-color:                     @blue;
    font:                           "JetBrainsMono Nerd Font 14";
}

inputbar {
    children:                       [ entry ];
    background-color:               @bg1;
    padding:                        4px 12px 10px 12px;
    border:                         0px 0px 1px 0px;
    border-color:                   @bg3;
}

entry {
    background-color:               @bg2;
    text-color:                     @fg0;
    placeholder-color:              @grey0;
    expand:                         true;
    horizontal-align:               0;
    placeholder:                    "  Search devices...";
    blink:                          true;
    border-radius:                  6px;
    padding:                        8px 10px;
    font:                           "JetBrainsMono Nerd Font 11";
}

prompt {
    enabled:                        false;
}

case-indicator {
    spacing:                        0;
}

mainbox {
    background-color:               @bg0;
    children:                       [ message, inputbar, listview ];
    spacing:                        0px;
    padding:                        0px;
}

listview {
    background-color:               @bg0;
    columns:                        1;
    lines:                          5;
    spacing:                        2px;
    cycle:                          true;
    dynamic:                        true;
    layout:                         vertical;
    scrollbar:                      false;
    padding:                        6px;
}

element {
    background-color:               @bg0;
    text-color:                     @fg0;
    orientation:                    horizontal;
    border-radius:                  6px;
    padding:                        8px 10px;
    cursor:                         pointer;
}

element-icon {
    size:                           22px;
    margin:                         0px 10px 0px 4px;
    vertical-align:                 0.5;
    background-color:               transparent;
}

element-text {
    expand:                         true;
    horizontal-align:               0;
    vertical-align:                 0.5;
    margin:                         2px 0px 2px 2px;
    background-color:               transparent;
}

element selected {
    background-color:               @bg2;
    text-color:                     @blue;
}

element normal.urgent,
element.alternate.urgent {
    background-color:               @bg0;
    text-color:                     @green;
}

element.selected.urgent {
    background-color:               @bg2;
    text-color:                     @green;
}

element.normal.active,
element.alternate.active {
    background-color:               @bg0;
    text-color:                     @fg0;
}

element.selected.active {
    background-color:               @bg2;
    text-color:                     @yellow;
}
